# Copie para .env e ajuste conforme o ambiente.

PORT=3000
PORTAL_TITLE=Portal de Produção Comercial
DATA_DIR=./data

# Intervalo de sincronização automática com o SFTP (minutos)
SYNC_INTERVAL_MINUTES=30

# Configuração do SFTP onde a RPE disponibiliza o extrato.
# Deixe SFTP_HOST em branco para desativar a sincronização automática
# e usar apenas o upload manual da planilha pelo portal.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_REMOTE_PATH=/
# Filtra pelo trecho do nome do arquivo, ex.: Rob_Producao_Comercial
SFTP_FILE_MATCH=

# Autenticação básica opcional para proteger o portal (deixe em branco para desativar)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
